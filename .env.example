# ============================================================
# Smart Health PHC/CHC Environment Configuration
# ============================================================

# Application Environment (development / production)
APP_ENV=development

# Server Port (Cloud Run dynamically sets PORT; defaults to 8080)
PORT=8080

# Google Gemini API Key for AI Forecasting (Demand & Footfall)
# Leave blank to run with built-in heuristic statistical AI engine
GEMINI_API_KEY=

# Firebase / Google Cloud Firestore Project ID
# Leave blank to use zero-config local thread-safe data store
FIREBASE_PROJECT_ID=

# Path to Firebase Service Account Credentials JSON (Optional)
# On Google Cloud Run, default application credentials (IAM) are used automatically.
FIREBASE_CREDENTIALS_PATH=

# Stock Alert Settings
LOW_STOCK_THRESHOLD_PERCENT=20
EXPIRY_WARNING_DAYS=30
